# ==========================================
# SPRINTHUB CRM
# ==========================================
# Token da API: SprintHub → Configurações → API
SPRINTHUB_API_TOKEN=seu_token_aqui
# Nome da instância (aparece na URL do SprintHub, ex: "ourodogege")
SPRINTHUB_INSTANCE=sua_instancia_aqui
# Mapeamento de crm_column ID → nome da etapa (JSON)
# Preencha após verificar os IDs em Configurações → CRM → Colunas
SPRINTHUB_STAGE_MAP={"ID_COLUNA_1":"Contato Engajado","ID_COLUNA_2":"Modelo Escolhido","ID_COLUNA_3":"Interesse em Visitar a Loja","ID_COLUNA_4":"Visitou e não Comprou","ID_COLUNA_5":"Comprou","ID_COLUNA_6":"Perdido"}

