# ==========================================
# SPRINTHUB CRM
# ==========================================
# Token da API: SprintHub → Configurações → API
SPRINTHUB_API_TOKEN=seu_token_aqui
# Nome da instância (aparece na URL do SprintHub, ex: "ourodogege")
SPRINTHUB_INSTANCE=sua_instancia_aqui
# Mapeamento de crm_column ID → nome da etapa (JSON).
# IDs reais do pipeline "Vendas - Visita Loja" (id=3) da Bossa Elétricas:
SPRINTHUB_STAGE_MAP={"7":"Contato Engajado","8":"Modelo Escolhido","9":"Interesse em Visitar a Loja","10":"Visitou e não Comprou","11":"Comprou","12":"Perdido"}

# ==========================================
# SUPABASE (autenticação e armazenamento seguro)
# ==========================================
# Project URL e service_role key encontrados em: supabase.com → Project Settings → API
# ATENÇÃO: SUPABASE_SERVICE_KEY é secreta — nunca commitar no git!
